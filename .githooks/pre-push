#!/usr/bin/env bash
# Pre-push: scan all backend services for vulnerabilities, test/build changed services,
# and build the frontend when related files are in the push.
# Skip with: SKIP_GIT_HOOKS=1 git push ...

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [[ "${SKIP_GIT_HOOKS:-}" == "1" ]]; then
  echo "[pre-push] SKIP_GIT_HOOKS=1 — skipping builds"
  exit 0
fi

# Collect commits being pushed (stdin: local_ref local_sha remote_ref remote_sha).
changed_files=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_sha:-}" ]] && continue

  # Deleting a remote ref — nothing to build.
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi

  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # New branch: compare against merge-base with default branch, or all reachable commits.
    range="$local_sha"
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      range="$(git merge-base origin/main "$local_sha")..$local_sha"
    elif git rev-parse --verify origin/master >/dev/null 2>&1; then
      range="$(git merge-base origin/master "$local_sha")..$local_sha"
    fi
  else
    range="${remote_sha}..${local_sha}"
  fi

  files="$(git diff --name-only --diff-filter=ACMR "$range" 2>/dev/null || true)"
  if [[ -n "$files" ]]; then
    changed_files+="$files"$'\n'
  fi
done

needs_frontend=0
needs_auth=0
needs_user=0
needs_gateway=0
needs_backend=0

while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  case "$file" in
    frontend/*) needs_frontend=1 ;;
    backend/auth-service/*) needs_backend=1; needs_auth=1 ;;
    backend/user-service/*) needs_backend=1; needs_user=1 ;;
    backend/api-gateway/*) needs_backend=1; needs_gateway=1 ;;
    backend/*) needs_backend=1 ;;
  esac
done <<< "$changed_files"

if [[ "$needs_frontend" -eq 0 && "$needs_backend" -eq 0 ]]; then
  exit 0
fi

echo "[pre-push] Running checks for changes being pushed..."

OUT_DIR="$(mktemp -d)"
trap 'rm -rf "$OUT_DIR"' EXIT

build_backend_service() {
  local name="$1"
  local pkg="$2"

  echo ""
  echo "==> Backend: testing ${name}"
  (
    cd "${ROOT}/backend/${name}"
    go test ./... -v -count 1
  )
  echo "==> Backend: ${name} tests passed"

  echo ""
  echo "==> Backend: building ${name}"
  (
    cd "${ROOT}/backend/${name}"
    CGO_ENABLED=0 go build -o "${OUT_DIR}/${name}" "./cmd/${pkg}"
  )
  echo "==> Backend: ${name} OK"
}

build_frontend() {
  echo ""
  echo "==> Frontend: building"
  if [[ ! -d "${ROOT}/frontend/node_modules" ]]; then
    echo "error: frontend/node_modules missing — run: (cd frontend && npm ci)" >&2
    exit 1
  fi
  (
    cd "${ROOT}/frontend"
    npm run build
  )
  echo "==> Frontend: OK"
}

# Scan every backend service when backend code is part of the push.
if [[ "$needs_backend" -eq 1 ]]; then
  echo ""
  echo "==> Backend: vulnerability scan all services"
  if ! make -C "${ROOT}/backend" security-check; then
    echo "error: backend vulnerability scans failed; refusing to push" >&2
    exit 1
  fi
fi

# Build backend services separately.
if [[ "$needs_auth" -eq 1 ]]; then
  build_backend_service "auth-service" "auth-service"
fi
if [[ "$needs_user" -eq 1 ]]; then
  build_backend_service "user-service" "user-service"
fi
if [[ "$needs_gateway" -eq 1 ]]; then
  build_backend_service "api-gateway" "api-gateway"
fi

# Build frontend separately.
if [[ "$needs_frontend" -eq 1 ]]; then
  build_frontend
fi

echo ""
echo "[pre-push] All required vulnerability scans, tests, and builds passed"
exit 0
